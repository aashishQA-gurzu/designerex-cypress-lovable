# Copy to `.env.local` and fill in. `.env.local` is git-ignored by the `*.local` rule
# and Vite loads it ahead of the committed `.env`.
#
# Local Supabase stack (default). Start it from the backend repository with
# `supabase start`, then read the values from `supabase status`.
VITE_SUPABASE_URL="http://127.0.0.1:54321"
VITE_SUPABASE_PUBLISHABLE_KEY="<PUBLISHABLE_KEY from supabase status>"
